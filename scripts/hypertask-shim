#!/usr/bin/env bash
# Prefer the native CLI. Keep the Node binary as an emergency fallback when htz
# has not been installed on a machine yet.
set -euo pipefail

HTZ="${HTZ_BIN:-$HOME/.local/bin/htz}"
NODE_CLI="${HYPERTASK_NODE_BIN:-$HOME/.npm-global/bin/hypertask-node}"

if [[ -x "$HTZ" ]]; then
  exec "$HTZ" "$@"
fi

exec "$NODE_CLI" "$@"
