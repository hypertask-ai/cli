#!/usr/bin/env bash
# Prefer the native CLI. Keep the Node binary as an emergency fallback when the
# native binary has not been installed on a machine yet.
set -euo pipefail

NATIVE_CLI="${HYPERTASK_NATIVE_BIN:-$HOME/.local/bin/hypertask}"
NODE_CLI="${HYPERTASK_NODE_BIN:-$HOME/.npm-global/bin/hypertask-node}"

if [[ -x "$NATIVE_CLI" ]]; then
  exec "$NATIVE_CLI" "$@"
fi

exec "$NODE_CLI" "$@"
